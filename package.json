{
  "name": "b3-portfolio-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio tracker para a B3 com apura\u00e7\u00e3o mensal de IR, arquitetura hexagonal e adapters Postgres/Microsoft Access.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @b3pt/core && npm run build -w @b3pt/api && npm run build -w @b3pt/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @b3pt/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:api": "npm run dev -w @b3pt/api",
    "dev:web": "npm run dev -w @b3pt/web",
    "db:migrate": "npm run db:migrate -w @b3pt/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
