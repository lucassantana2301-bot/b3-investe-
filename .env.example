# docker compose
POSTGRES_PASSWORD=troque-esta-senha
# Gere com: openssl rand -hex 32
API_KEY=
# Opcional: https://brapi.dev/dashboard (sem token só alguns tickers funcionam)
BRAPI_TOKEN=

# Execução local da API (apps/api)
# DB_DRIVER=postgres | access | memory
DB_DRIVER=postgres
DATABASE_URL=postgres://b3pt:troque-esta-senha@localhost:5432/b3pt
# DB_DRIVER=access (Windows):
# ACCESS_CONNECTION_STRING=Driver={Microsoft Access Driver (*.mdb, *.accdb)};Dbq=C:\dados\portfolio.accdb;
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
